# Copy to `.env` (gitignored) and fill in. Any OpenAI-compatible endpoint works:
# hosted APIs, Ollama, vLLM, LM Studio, opencode-go, ...
#
# The example values below target the opencode-go endpoint.

LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash

# Option A: put the key here (generated for your account)
# LLM_API_KEY=

# Option B: read the key from a JSON auth store at runtime (generic):
# `LLM_API_KEY_JSON` is a dotted path inside the JSON file.
LLM_API_KEY_FILE=~/.local/share/opencode/auth.json
LLM_API_KEY_JSON=opencode-go.key

# Optional: extra request headers as a JSON object (some gateways require them;
# opencode-go wants a session id to route requests). Generic, not opencode-only.
LLM_EXTRA_HEADERS={"x-opencode-session": "marl-traffic"}

# Reasoning effort for routine calls. Empty = omit the field entirely.
LLM_REASONING_EFFORT=low
# Effort used on congested snapshots (alerts/EVs/queues); empty disables
# escalation, i.e. every call keeps LLM_REASONING_EFFORT. Measured 2026-10-11:
# medium escalation was ~4x slower per call with no S3 gain, so keep it off.
LLM_ESCALATE_EFFORT=

# Optional tuning
LLM_TIMEOUT_S=90
LLM_MAX_CALLS=400
