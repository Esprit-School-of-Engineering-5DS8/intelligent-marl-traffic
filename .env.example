# Copy to .env and fill in your own keys. The CLI loads .env automatically.
# Shell-exported variables take precedence over values in .env.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter: one key for Gemma 4 and the other hosted open models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
FRONTEND_ORIGIN=http://localhost:5173

# LLM traffic controller (configs/agents/llm.yaml holds the defaults)
# groq | gemini | opencode | openrouter
COTRAFFIC_LLM_PROVIDER=groq
COTRAFFIC_LLM_MODEL=
COTRAFFIC_LLM_INTERVAL_S=60
COTRAFFIC_LLM_TIMEOUT=30
COTRAFFIC_LLM_MAX_CALLS=10
COTRAFFIC_LLM_MAX_TOKENS=700
COTRAFFIC_LLM_ATTEMPTS=2
COTRAFFIC_LLM_MIN_WALL_INTERVAL_S=10
COTRAFFIC_LLM_LOG=1

# LLM team controller (configs/agents/llm_team.yaml holds the defaults)
# The provider is a setting: groq | gemini | opencode. The backend decides whether
# calls are real: provider | mock | replay (mock and replay need no key).
COTRAFFIC_LLM_BACKEND=provider
COTRAFFIC_LLM_API_KEY=
COTRAFFIC_LLM_BASE_URL=https://opencode.ai/zen/go/v1
COTRAFFIC_LLM_MAX_CALLS=80

# Mapbox basemap (public pk. token; Settings → Integrations writes this)
MAPBOX_TOKEN=

# SUMO
SUMO_HOME="C:\Program Files (x86)\Eclipse\Sumo"
LIBSUMO_AS_TRACI=0
