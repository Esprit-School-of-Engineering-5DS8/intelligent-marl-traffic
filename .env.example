# Copy to .env and fill in your own keys. The CLI loads .env automatically.
# Shell-exported variables take precedence over values in .env.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_ORIGIN=http://localhost:5173

# LLM traffic controller (configs/agents/llm.yaml holds the defaults)
# Shared provider override; leave unset to use each controller config default.
# COTRAFFIC_LLM_PROVIDER=opencode
# COTRAFFIC_LLM_MODEL=deepseek-v4.1-flash
COTRAFFIC_LLM_INTERVAL_S=60
COTRAFFIC_LLM_TIMEOUT=30
COTRAFFIC_LLM_MAX_CALLS=10
COTRAFFIC_LLM_MAX_TOKENS=700
COTRAFFIC_LLM_ATTEMPTS=2
COTRAFFIC_LLM_MIN_WALL_INTERVAL_S=10
COTRAFFIC_LLM_LOG=1

# SUMO
SUMO_HOME="C:\Program Files (x86)\Eclipse\Sumo"
LIBSUMO_AS_TRACI=0

# LLM team (OpenCode Go). COTRAFFIC_LLM_* wins over the legacy LLM_* names.
COTRAFFIC_LLM_BACKEND=opencode
COTRAFFIC_LLM_BASE_URL=https://opencode.ai/zen/go/v1
COTRAFFIC_LLM_API_KEY=
COTRAFFIC_LLM_CACHE=results/llm_cache/llm_team.jsonl
COTRAFFIC_LLM_EXTRA_HEADERS=
