<?xml version="1.0" encoding="UTF-8"?>

<!--
    Monaco SUMO Traffic (MoST) Scenario — Phase 6 evaluation window.

    Derived from most.sumocfg (MoST, L. Codeca & J. Harri, VNC 2017; GPL).
    Differences, all documented approximations for the LLM/MARL runs:
    - Morning-peak start: begin=25200 (07:00); the config supports 30 minutes
      (end=28800). The committed Phase 6 evaluation ran the first 1000 steps
      (17 min) for LLM budget reasons - see docs/test/phase6/monaco.md.
      Route entries departing before `begin` are discarded by SUMO, so the
      full upstream route files are reused unchanged.
    - step-length 1.0 (MoST recommends 0.25 for sublane fidelity); the
      lateral-resolution setting is dropped because the sublane model is
      meaningless at 1 s. See docs/test/phase6/monaco.md.
    - most.parking.norerouters.add.xml (lighter than the allvisible variant),
      no per-run sim.log, verbose off.
-->

<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="in/most.net.xml"/>
        <route-files value="in/route/most.buses.flows.xml,in/route/most.trains.flows.xml,in/route/most.pedestrian.rou.xml,in/route/most.commercial.rou.xml,in/route/most.special.rou.xml,in/route/most.highway.flows.xml"/>
        <additional-files value="in/add/most.poly.xml,in/add/most.busstops.add.xml,in/add/most.trainstops.add.xml,in/add/most.parking.norerouters.add.xml,in/add/basic.vType.xml"/>
    </input>

    <time>
        <begin value="25200"/>
        <step-length value="1.0"/>
        <end value="28800"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <ignore-junction-blocker value="30"/>
        <collision.action value="none"/>
        <time-to-teleport value="120"/>
        <max-depart-delay value="900"/>
        <time-to-impatience value="30"/>
        <pedestrian.model value="striping"/>
        <pedestrian.striping.stripe-width value="0.55"/>
        <pedestrian.striping.jamtime value="30"/>
        <default.emergencydecel value="decel"/>
    </processing>

    <routing>
        <persontrip.transfer.car-walk value="parkingAreas,ptStops"/>
        <device.rerouting.probability value="1"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.pre-period value="300"/>
    </routing>

    <report>
        <verbose value="false"/>
        <duration-log.statistics value="true"/>
    </report>

    <random_number>
        <seed value="42"/>
    </random_number>

</configuration>
