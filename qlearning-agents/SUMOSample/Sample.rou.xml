<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Types de véhicules -->
    <vType id="car" vClass="passenger" color="1,1,0"/>
    <vType id="emergency" vClass="emergency" color="1,0,0" guiShape="emergency" speedFactor="1.3"/>

    <!-- Flux de voitures Est → Ouest (E3 → E4) -->
    <flow id="flow_EW" type="car" begin="0" end="120" number="40" from="E3" to="E4" departSpeed="max"/>

    <!-- Flux de voitures Ouest → Est (-E4 → -E3) -->
    <flow id="flow_WE" type="car" begin="0" end="120" number="40" from="-E4" to="-E3" departSpeed="max"/>

    <!-- Quelques voitures depuis le sud (E5) -->
    <flow id="flow_S" type="car" begin="10" end="100" number="15" from="E5" to="E4" departSpeed="max"/>

    <!-- Une ambulance au milieu -->
    <trip id="ambulance" type="emergency" depart="25" from="E3" to="E4"/>

</routes>
