<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="car" vClass="passenger" color="1,1,0"/>
    <vType id="emergency" vClass="emergency" color="1,0,0"
           guiShape="emergency" speedFactor="1.3"/>

    <route id="west_left" edges="E3 E6"/>
    <route id="west_straight" edges="E3 E4"/>
    <route id="west_right" edges="E3 -E5"/>
    <route id="east_left" edges="-E4 -E5"/>
    <route id="east_straight" edges="-E4 -E3"/>
    <route id="east_right" edges="-E4 E6"/>
    <route id="south_left" edges="E5 -E3"/>
    <route id="south_straight" edges="E5 E6"/>
    <route id="south_right" edges="E5 E4"/>
    <route id="north_left" edges="-E6 E4"/>
    <route id="north_straight" edges="-E6 -E5"/>
    <route id="north_right" edges="-E6 -E3"/>

    <!-- Un flux indépendant par passage piéton de l'intersection -->
    <personFlow id="ped_west" begin="0" end="600" period="30">
        <walk from="-E3" to="E3"/>
    </personFlow>
    <personFlow id="ped_east" begin="0" end="600" period="30">
        <walk from="E4" to="-E4"/>
    </personFlow>
    <personFlow id="ped_south" begin="0" end="600" period="30">
        <walk from="-E5" to="E5"/>
    </personFlow>
    <personFlow id="ped_north" begin="0" end="600" period="30">
        <walk from="E6" to="-E6"/>
    </personFlow>

    <flow id="flow_west_left" type="car" route="west_left" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_west_straight" type="car" route="west_straight" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_west_right" type="car" route="west_right" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_east_left" type="car" route="east_left" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_east_straight" type="car" route="east_straight" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_east_right" type="car" route="east_right" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_south_left" type="car" route="south_left" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_south_straight" type="car" route="south_straight" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_south_right" type="car" route="south_right" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_north_left" type="car" route="north_left" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_north_straight" type="car" route="north_straight" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>
    <flow id="flow_north_right" type="car" route="north_right" begin="0"
          end="600" number="25" departSpeed="max" departLane="best"/>

    <trip id="ambulance" type="emergency" depart="25" from="E3" to="E4"/>
</routes>
